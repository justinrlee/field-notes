# Copy to .env next to run.sh and adjust. run.sh reads it for every client.
# One KEY=value per line, no quotes. A variable set in the shell wins over the
# value here, e.g. DEBUG_STATS=1 ./run.sh producer-tuned

# Gateway route address the clients bootstrap from. Required.
# The gateway advertises one port per broker (19093-19095); `./run.sh preflight`
# checks that each one is reachable.
KAFKA_BOOTSTRAP=ip-10-32-1-10.ap-southeast-1.compute.internal:19092

# Address the UIs (ports 8081-8084) listen on.
#   0.0.0.0    reachable over the network: limit the security group to your
#              workstation's IP. The UIs have no authentication.
#   127.0.0.1  reachable only on the instance, i.e. through an SSH tunnel.
UI_BIND=0.0.0.0

# Topic every client reads or writes, and the consumer group the consumers join.
# The dashboard header shows the topic. Defaults shown.
TOPIC=orders
GROUP_ID=demo-consumers

# Partitions each producer spreads its messages over, in turn: 0, 1, ... N-1.
# Must not exceed the topic's partition count; preflight checks it, and a
# producer shows a red band if the topic has fewer.
PARTITIONS=6

# 1 logs one librdkafka statistics payload per client at startup, and checks
# the fields the UI depends on.
DEBUG_STATS=0

# Extra librdkafka properties for every client: KAFKA_CFG_<PROPERTY>, with the
# dots of the property name written as underscores. None are needed for a
# plaintext gateway. Names show up in preflight output; values never reach the
# UI. For example:
# KAFKA_CFG_CLIENT_RACK=apse1-az1

# UI ports. run.sh uses these for the clients, and run-dashboard.sh passes them
# to the dashboard page. Defaults shown.
PRODUCER_TUNED_PORT=8081
PRODUCER_FRAGILE_PORT=8082
CONSUMER_1_PORT=8083
CONSUMER_2_PORT=8084
DASHBOARD_PORT=8090
